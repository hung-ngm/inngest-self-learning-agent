{
  "name": "inngest-self-learning-agent",
  "version": "0.1.0",
  "description": "A durable self-learning AI agent built with Inngest + pi-ai that scores responses and iterates on prompts",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "INNGEST_DEV=1 bun --watch src/worker.ts",
    "start": "bun src/worker.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "webhooks": "bun scripts/list-webhook-responses.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "inngest": "4.0.0-alpha.6",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "prettier --write"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
